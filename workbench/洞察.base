filters:
  and:
    - 'file.ext == "md"'
    - 'file.folder == "insights/agent-memory"'
    - 'note.kind == "insight"'
    - 'note.status == "accepted"'
    - '/[0-9]{8}/.matches(file.name)'
formulas:
  document: 'file.asLink(if(note.title, note.title, file.name))'
  cycle_date: 'file.name.replace(/^.*?([0-9]{4})([0-9]{2})([0-9]{2}).*$/, "$1-$2-$3")'
properties:
  formula.document:
    displayName: 洞察与待验证判断
  formula.cycle_date:
    displayName: 研究轮次
views:
  - type: table
    name: 最近正式洞察
    limit: 10
    order:
      - formula.document
      - formula.cycle_date
    sort:
      - property: formula.cycle_date
        direction: DESC
      - property: file.name
        direction: DESC
