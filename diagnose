#!/usr/bin/env python3
"""Serve Research Desk diagnostics on loopback and open the default browser."""
import argparse
import errno
import json
import re
import subprocess
import sys
import webbrowser
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from urllib.parse import urlsplit

ROOT = Path(__file__).resolve().parent
ASSETS = ROOT / "scripts" / "diagnose_ui"
ROUTES = {
    "/": ("index.html", "text/html"),
    "/index.html": ("index.html", "text/html"),
    "/app.js": ("app.js", "text/javascript"),
    "/style.css": ("style.css", "text/css"),
}


def origin_repository():
    """Extract only the public owner/name portion, never URL credentials."""
    try:
        remote = subprocess.check_output(
            ["git", "-C", str(ROOT), "remote", "get-url", "origin"],
            stderr=subprocess.DEVNULL, text=True,
        ).strip()
    except (OSError, subprocess.CalledProcessError):
        return ""
    match = re.fullmatch(
        r"(?:https?://(?:[^/]*@)?github\.com/|ssh://git@github\.com/|git@github\.com:)"
        r"([A-Za-z0-9-]+/[A-Za-z0-9_.-]+?)(?:\.git)?/?", remote,
    )
    return match.group(1) if match else ""


class DiagnosticPage(BaseHTTPRequestHandler):
    def do_GET(self):
        path = urlsplit(self.path).path
        if path == "/workspace.js":
            content_type = "text/javascript"
            payload = self.server.workspace_script
        elif path in ROUTES:
            filename, content_type = ROUTES[path]
            payload = (ASSETS / filename).read_bytes()
        else:
            self.send_error(404)
            return
        self.send_response(200)
        self.send_header("Content-Type", content_type + "; charset=utf-8")
        self.send_header("Content-Length", str(len(payload)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(payload)


def main():
    parser = argparse.ArgumentParser(description="在本机打开 Research Desk 诊断台")
    parser.add_argument("--port", type=int, default=8765, help="本地端口（默认 8765）")
    parser.add_argument("--no-browser", action="store_true", help="仅打印访问地址")
    args = parser.parse_args()
    if not 1 <= args.port <= 65535:
        parser.error("端口须在 1 至 65535 之间")
    try:
        server = ThreadingHTTPServer(("127.0.0.1", args.port), DiagnosticPage)
    except OSError as error:
        if error.errno != errno.EADDRINUSE:
            raise
        parser.exit(1, f"端口 {args.port} 已被占用。请检查已有诊断台，或用 --port 指定其他端口。\n")
    with server:
        config = {"repository": origin_repository()}
        server.workspace_script = ("window.diagnoseWorkspace = " + json.dumps(config) + ";").encode()
        url = f"http://127.0.0.1:{args.port}/"
        print(f"Research Desk 诊断台：{url}\n按 Ctrl+C 关闭服务。", flush=True)
        if not args.no_browser:
            try:
                if not webbrowser.open(url, new=2):
                    print("请在浏览器中打开上面的地址。", flush=True)
            except (OSError, webbrowser.Error):
                print("请在浏览器中打开上面的地址。", flush=True)
        try:
            server.serve_forever()
        except KeyboardInterrupt:
            pass


if __name__ == "__main__":
    main()
