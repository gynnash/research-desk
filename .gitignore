/.obsidian

# One editable local workbench; generated compatibility files are local too.
/config/local/
/config/research_topics.yaml
/config/cycles/default.yaml
/config/runtime.yaml
/config/automation.yaml
/config/membership_budget.yaml
/config/research_state.yaml
/config/confirmation.yaml
/config/confirmation-v2.yaml
/config/admission.yaml
/config/writing_admission.yaml
/config/writing_style.md

# Personal SDK request accounting and live smoke receipts stay on this machine.
# Keep these files locally: they are still used for budget accounting.
/reports/test/*/codex-requests/
/reports/test/*/codex-sdk-smoke/

# Secrets and local credentials (keep shareable placeholders).
.env
.env.*
!.env.example
!.env.*.example
.aws/
.ssh/
.credentials/
.netrc
.api_key
.api_keys
api_keys.*
credentials.json
credentials.yaml
credentials.yml
secrets.json
secrets.yaml
secrets.yml
*.pem
*.key
*.p12
*.pfx
id_rsa
id_ed25519

# ResearchDesk OAuth credentials must live outside this repository and Vault.
# These patterns only defend against accidental local copies.
/.researchdesk-auth/
/.researchdesk-membership/
researchdesk-oauth*.json
researchdesk-membership-profile*.json

# Local dependencies and caches.
node_modules/
.venv/
.venv-membership/
venv/
.cache/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
/reports/test/*/.offline.lock

# OS files, editor backups, and temporary files.
.DS_Store
._*
Thumbs.db
Desktop.ini
*~
*.swp
*.swo
*.bak
*.tmp
*.temp
~$*
